# Credentials for the deployed SystemDNA app. Copy to infra/.env, fill in, then run
# infra/scripts/set-app-env.sh. infra/.env is git-ignored: never commit it.

# IBM Bob Shell API key (Fixer, Inspector and Cartographer agents).
BOB_API_KEY=

# GitHub fine-grained token for draft PRs. Limit it to the demo repo(s) with
#   Contents: Read and write
#   Pull requests: Read and write
GITHUB_TOKEN=

# Optional alternative to GITHUB_TOKEN: a GitHub App. Leave empty to use the token.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Path to the app's .pem file (relative to infra/, or absolute). set-app-env.sh uploads
# its contents as GITHUB_APP_PRIVATE_KEY; the file itself never leaves your machine.
GITHUB_APP_PRIVATE_KEY_PATH=
