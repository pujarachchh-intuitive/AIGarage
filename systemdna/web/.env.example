# Copy to .env.local and fill in. Never commit .env.local.

# --- Live backend (optional) -------------------------------------------------
# FastAPI server from the PRD. Leave empty to run on demo data.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_TOKEN=

# --- Repository ingestion ----------------------------------------------------
# Where connected repos and their graphs are stored (default: web/.data).
SYSTEMDNA_DATA_DIR=
# Path to the scanner (default: ../core/scanner/ts-scan.mjs). Run npm install there first.
SYSTEMDNA_SCANNER=

# --- GitHub agent --------------------------------------------------------------
# Lets the agent push a branch and open DRAFT pull requests.
# Use a fine-grained token limited to the repos you want, with:
#   Contents: Read and write
#   Pull requests: Read and write
# Server-side only: it is never sent to the browser.
GITHUB_TOKEN=

# --- IBM Bob --------------------------------------------------------------------
# Bob Shell API key (from your IBM Bob account). Used by the Bob Inspector (reviews
# GitHub agent diffs) and the Bob Cartographer (enriches connected repos).
# Server-side only: passed to the `bob` process through its environment.
BOB_API_KEY=
# Path to the bob CLI if it is not on the PATH (for example C:\...\bob.cmd).
BOB_CLI=
# Limits per Bob run (defaults: 240000 ms, 3 Bobcoins, 20 turns).
BOB_TIMEOUT_MS=
BOB_MAX_COST=
BOB_MAX_TURNS=
# Bobcoin budget for one whole change run: every Fixer plus the Inspector (default 5).
BOB_RUN_MAX_COST=
