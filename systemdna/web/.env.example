# Copy to .env.local and fill in. Never commit .env.local.

# --- Live backend (optional) -------------------------------------------------
# FastAPI server from the PRD. Leave empty to run on demo data.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_TOKEN=

# --- Repository ingestion ----------------------------------------------------
# Where connected repos and their graphs are stored (default: web/.data).
SYSTEMDNA_DATA_DIR=
# Path to the scanner (default: ../core/scanner/ts-scan.mjs). Run npm install there first.
SYSTEMDNA_SCANNER=

# --- GitHub agent --------------------------------------------------------------
# Preferred: a GitHub App. The agent gets a 1-hour token for each repo and its
# PRs show up as <slug>[bot]. Create the app with Contents: Read and write,
# Pull requests: Read and write, Metadata: Read-only, and set its Setup URL to
#   http://localhost:3100/api/github/install/callback
# Keep the .pem file OUTSIDE the repo.
GITHUB_APP_ID=
# The app's URL name: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
# Or paste the key inline instead (use 
 for new lines). Handy on AWS.
GITHUB_APP_PRIVATE_KEY=

# Fallback when no app is set up: a personal fine-grained token.
# Lets the agent push a branch and open DRAFT pull requests.
# Use a fine-grained token limited to the repos you want, with:
#   Contents: Read and write
#   Pull requests: Read and write
# Server-side only: it is never sent to the browser.
GITHUB_TOKEN=
