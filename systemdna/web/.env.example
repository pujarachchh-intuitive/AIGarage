# Copy to .env.local and fill in. Never commit .env.local.

# --- Live backend (optional) -------------------------------------------------
# FastAPI server from the PRD. Leave empty to run on demo data.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEMO_TOKEN=

# --- Repository ingestion ----------------------------------------------------
# Where connected repos and their graphs are stored (default: web/.data).
SYSTEMDNA_DATA_DIR=
# Path to the scanner (default: ../core/scanner/ts-scan.mjs). Run npm install there first.
SYSTEMDNA_SCANNER=

# --- GitHub agent --------------------------------------------------------------
# Lets the agent push a branch and open DRAFT pull requests.
# Use a fine-grained token limited to the repos you want, with:
#   Contents: Read and write
#   Pull requests: Read and write
# Server-side only: it is never sent to the browser.
GITHUB_TOKEN=
